<?xml version="1.0" encoding="utf-8"?>
<!-- Floating "liquid glass" pill behind the bottom navigation bar. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- translucent glass body + hairline edge -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <solid android:color="@color/nav_pill_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/nav_pill_stroke" />
        </shape>
    </item>

    <!-- top sheen, fading downwards, sells the curvature -->
    <item
        android:bottom="24dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="33dp"
                android:topRightRadius="33dp" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="@color/nav_pill_sheen"
                android:type="linear" />
        </shape>
    </item>

</layer-list>
