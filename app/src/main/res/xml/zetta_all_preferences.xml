<?xml version="1.0" encoding="utf-8"?>
<!--
  zetta: the whole settings tree flattened into one screen.
  The old build drilled down into six sub screens; this is the same preferences in one continuous
  scroll, with shortcuts (queue / logs / cookies / templates) pinned at the top.
  Each block below is still owned by its original SettingModule. See ZettaSettingsModule.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

