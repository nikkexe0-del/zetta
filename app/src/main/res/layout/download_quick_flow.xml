<?xml version="1.0" encoding="utf-8"?>
<!-- Inline download flow: paste or search → quality → format → subtitles → download -->
<com.google.android.material.card.MaterialCardView
    android:id="@+id/quick_flow_card"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:id="@+id/flow_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download"
            android:textAppearance="@style/TextAppearance.Zetta.SectionTitle"
            android:layout_marginBottom="16dp" />

        <!-- Input: paste link or search -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/flow_url_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/paste_link"
            app:endIconMode="clear_text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/flow_url_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Title override -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/flow_title_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/title"
            app:endIconMode="clear_text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/flow_title_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quality chips -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/quick_quality"
            android:textAppearance="@style/TextAppearance.Zetta.Caption" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/flow_quality_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleLine="true"
            app:singleSelection="true" />

        <!-- Format: mp4 / mp3 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/format"
            android:textAppearance="@style/TextAppearance.Zetta.Caption" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/flow_format_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleLine="true"
            app:singleSelection="true" />

        <!-- Subtitles checkbox -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/flow_subtitles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/subtitles" />

        <!-- Download button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/flow_download_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/download" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
