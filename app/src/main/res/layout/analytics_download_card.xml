<?xml version="1.0" encoding="utf-8"?>
<!-- Feed style row: thumbnail on the left, metadata on the right -->
<com.deniscerri.ytdl.ui.widget.LiquidGlassCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/analytics_item_card"
    app:cardBackgroundColor="@color/carbon_black"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/glass_card_margin"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- LEFT: the thumbnail -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="132dp"
            android:layout_height="76dp"
            app:cardCornerRadius="@dimen/glass_corner_radius_small"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/item_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/item_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:background="@drawable/zetta_duration_pill"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <!-- RIGHT: the data -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/item_title"
            android:textColor="@color/text_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Zetta.CardTitle" />

            <TextView
                android:id="@+id/item_author"
            android:textColor="@color/text_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.7"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Zetta.Caption" />

            <TextView
                android:id="@+id/item_meta"
            android:textColor="@color/text_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.6"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Zetta.Caption" />

        </LinearLayout>

    </LinearLayout>

</com.deniscerri.ytdl.ui.widget.LiquidGlassCardView>
